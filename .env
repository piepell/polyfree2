# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Auth
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Processing
MAX_IMAGES=200
MAX_IMAGE_SIZE_MB=50
COLMAP_QUALITY=high  # low, medium, high
USE_GPU=true
GPU_DEVICE=0

# Paths
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
TEMP_DIR=/tmp/photogrammetry
COLMAP_PATH=colmap

# Quality presets
QUALITY_LOW_MAX_IMAGES=50
QUALITY_LOW_IMAGE_SIZE=1024
QUALITY_MEDIUM_MAX_IMAGES=100
QUALITY_MEDIUM_IMAGE_SIZE=2048
QUALITY_HIGH_MAX_IMAGES=200
QUALITY_HIGH_IMAGE_SIZE=4096